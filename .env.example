# =============================================================================
# ENVIRONMENT VARIABLES FOR FULFILLMENT SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
FULFILLMENT_SERVICE_PORT=8006

# Database Connection (Local PostgreSQL - Port 5438)
CONNECTION_STRING=Host=localhost;Port=5438;Database=fulfillment_db;Username=postgres;Password=postgres
FULFILLMENT_CONNECTION_STRING=Host=localhost;Port=5438;Database=fulfillment_db;Username=postgres;Password=postgres
FULFILLMENT_DB_PORT=5438
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ (Docker network: rabbitmq; Local host: localhost)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
