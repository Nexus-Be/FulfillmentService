# Environment variables for Fulfillment Service
ASPNETCORE_ENVIRONMENT=Development
FULFILLMENT_SERVICE_PORT=8006
FULFILLMENT_DB_PORT=5438

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-calm-shadow-a1b7qj0e.ap-southeast-1.aws.neon.tech;Port=5432;Database=fulfillment_db;Username=neondb_owner;Password=<REPLACE_WITH_FULFILLMENT_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Database (PostgreSQL Local Fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_DB_PASSWORD>

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
