# =============================================================================
# NEXUS FULFILLMENT SERVICE - ENVIRONMENT (.env.example)
# =============================================================================
# DB dùng Neon Cloud PostgreSQL. Hạ tầng dùng chung nexus-network.

ASPNETCORE_ENVIRONMENT=Development
FULFILLMENT_SERVICE_PORT=8006

# Database (Neon Cloud PostgreSQL)
FULFILLMENT_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/fulfillment?sslmode=require&channel_binding=require

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
