# =============================================================================
# ENVIRONMENT VARIABLES FOR FULFILLMENT SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
FULFILLMENT_SERVICE_PORT=8006

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-snowy-field-b3pfk600-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=fulfillment_service;Username=neondb_owner;Password=<REPLACE_WITH_FULFILLMENT_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
FULFILLMENT_CONNECTION_STRING=Host=ep-snowy-field-b3pfk600-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=fulfillment_service;Username=neondb_owner;Password=<REPLACE_WITH_FULFILLMENT_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
