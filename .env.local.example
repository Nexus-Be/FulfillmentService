# DB local (cụm src/Infrastructure/databases). Hạ tầng dùng chung nexus-network.

ASPNETCORE_ENVIRONMENT=Development
FULFILLMENT_SERVICE_PORT=8006

# Database (Neon Cloud PostgreSQL)
FULFILLMENT_DB_CONNECTION=Host=localhost;Port=5438;Database=fulfillment_db;Username=postgres;Password=postgres

# Internal service-to-service authentication
