# Environment variables for Fulfillment Service
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8006

# Database (PostgreSQL Port: 5437)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5437;Database=fulfillment_db;Username=postgres;Password=postgres

# RabbitMQ
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__User=guest
RabbitMq__Password=guest

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
