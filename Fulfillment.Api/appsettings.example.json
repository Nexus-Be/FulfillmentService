{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Carriers": {
    "DefaultCarrierCode": "GHN",
    "GHN": {
      "Environment": "Staging",
      "BaseUrl": "https://dev-online-gateway.ghn.vn",
      "Token": "<YOUR_GHN_TOKEN>",
      "ShopId": "<YOUR_GHN_SHOP_ID>",
      "WebhookSecret": "ghn-webhook-secret-key"
    }
  },
  "Services": {
    "CommerceService": {
      "BaseUrl": "http://localhost:8003",
      "DeliveryStatusPath": "api/v1/sub-orders/{subOrderId}/delivery-status"
    },
    "NotificationService": {
      "BaseUrl": "http://localhost:8007"
    }
  },
  "InternalSecurity": {
    "ServiceKey": "eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e"
  },
  "ConnectionStrings": {
    "DefaultConnection": "postgresql://<USERNAME>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require&channel_binding=require"
  },
  "Otel": {
    "Endpoint": "http://localhost:4317"
  }
}
