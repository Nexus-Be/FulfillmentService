# =============================================================================
# NEXUS FULFILLMENT SERVICE - ENVIRONMENT (.env.example)
# =============================================================================
# DB dùng Neon Cloud PostgreSQL. Hạ tầng dùng chung nexus-network.

ASPNETCORE_ENVIRONMENT=Development
FULFILLMENT_SERVICE_PORT=8006

# Database (Neon Cloud PostgreSQL)
FULFILLMENT_DB_CONNECTION=Host=<HOST>;Port=5432;Database=fulfillment;Username=<USERNAME>;Password=<PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e

# Downstream Services
COMMERCE_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8007

# Carrier Integration (Giao Hang Nhanh - GHN)
Carriers__DefaultCarrierCode=GHN
GHN_ENVIRONMENT=Staging
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=1e2442e5-1e19-477b-8955-cffc3ce9dbf0
GHN_SHOP_ID=241623
GHN_WEBHOOK_SECRET=Matkhaumanh

# AI Schema Inference (Google Gemini / Gemma)
GEMINI_API_KEY=<REPLACE_WITH_GEMINI_API_KEY>
GEMINI_MODEL=gemma-4-31b-it

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
